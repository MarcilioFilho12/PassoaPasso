# Copie para .env.local. Nunca commite valores reais.
# Na Vercel: Settings → Environment Variables (Production).

# Meta Conversions API (servidor). Sem prefixo NEXT_PUBLIC_.
META_PIXEL_ID=
META_CAPI_TOKEN=
# META_CAPI_TEST_EVENT_CODE=

# Google Ads — conversão no servidor. Use o número sem "AW-" e o rótulo da ação.
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
